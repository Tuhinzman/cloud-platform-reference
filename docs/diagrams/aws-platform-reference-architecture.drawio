<mxCell id="fl4" value="Record digest in Git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E5C8A;strokeWidth=1.5;fontSize=11;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="774" y="852" width="168" height="46" as="geometry"/></mxCell>
<mxCell id="fl5" value="Argo CD reconciles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E5C8A;strokeWidth=1.5;fontSize=11;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="956" y="852" width="168" height="46" as="geometry"/></mxCell>
<mxCell id="fl6" value="Traffic reaches workload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E5C8A;strokeWidth=1.5;fontSize=11;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1138" y="852" width="168" height="46" as="geometry"/></mxCell>
<mxCell id="fl7" value="Telemetry and evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E5C8A;strokeWidth=1.5;fontSize=11;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="852" width="168" height="46" as="geometry"/></mxCell>
<mxCell id="fl8" value="Destroy after window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E5C8A;strokeWidth=1.5;fontSize=11;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1502" y="852" width="168" height="46" as="geometry"/></mxCell>
<mxCell id="p3_t0" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="158" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t1" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="212" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t2" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="266" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t3" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="320" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t4" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="374" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t5" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="428" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t6" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="482" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t7" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="536" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t8" value="Validated across the closed runtime windows. Not currently running." style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5A6672;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1318" y="580" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t9" value="CI/CD:  coverage across the seventeen justified project-built components is partial. Some carry the full validated build, scan, SBOM and health path, some reach lint only, and the rest are not wired. Per-component status: workload SERVICE-INVENTORY.md." style="text;html=1;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="52" y="660" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t10" value="Accepted ADR-0017 selects the full justified project-built fleet as the programme target; implementation has not begun for that breadth. Language-tier templates are an implementation mechanism, never a scope gate." style="text;html=1;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="52" y="698" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t11" value="Runtime is not live and no window is currently authorized.  Four components have published images read back by digest, so there is per-service digest evidence but no fleet-wide publication.  Promotion and rollback are accepted architecture and have not been exercised." style="text;html=1;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="52" y="736" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t12" value="The sequence above is the target flow, not a statement that it runs today; the status panel states which segments are proven.  Ephemeral runtime resources are removed after every approved window, and persistent foundation resources are intentionally retained.  The platform is the product, and AstroShop is the workload used to validate it." style="text;html=1;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5A6672;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="52" y="926" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t13" value="Data / artifact flow" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6672;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48" y="1020" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t14" value="Control / identity flow  (dashed)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6672;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48" y="1040" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t15" value="Telemetry / evidence flow  (dotted)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6672;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48" y="1060" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t16" value="VALIDATED  proven by captured evidence, at the badge's stated scope" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6672;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="1020" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t17" value="PARTIAL  capability exists for part of the fleet only" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6672;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="1040" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t18" value="NOT LIVE  implemented and validated in closed windows; no runtime now" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6672;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="1060" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t19" value="PLANNED  accepted or designed, not yet exercised" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6672;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="790" y="1020" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t20" value="RETAINED  survives environment teardown by design" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6672;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="790" y="1040" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p3_t21" value="DEFERRED  decision deliberately left open" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6672;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="790" y="1060" width="320" height="40" as="geometry"/></mxCell>
