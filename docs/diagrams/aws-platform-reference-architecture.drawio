<mxCell id="g4" value="4)  ENVIRONMENT LIFECYCLE  [VALIDATED]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF8;strokeColor=#1D6F42;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#1D6F42;fontFamily=Helvetica;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1290" y="92" width="400" height="616" as="geometry"/></mxCell>
<mxCell id="gcost" value="OPERATIONS AND COST GUARDRAILS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#2E5C8A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#2E5C8A;fontFamily=Helvetica;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1308" y="552" width="362" height="142" as="geometry"/></mxCell>
<mxCell id="legend" value="LEGEND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#2E5C8A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#2E5C8A;fontFamily=Helvetica;arcSize=6;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="1660" height="108" as="geometry"/></mxCell>
<mxCell id="sm" value="AWS Secrets Manager

system of record;
sits outside the cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3E9;strokeColor=#EC7211;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="142" width="175" height="62" as="geometry"/></mxCell>
<mxCell id="eso" value="External Secrets
Operator

controlled synchronisation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EEFA;strokeColor=#6B4FBB;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="239" y="142" width="175" height="62" as="geometry"/></mxCell>
<mxCell id="k8ss" value="Kubernetes Secret

delivery mechanism only,
never the system of record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EEFA;strokeColor=#6B4FBB;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="224" width="175" height="62" as="geometry"/></mxCell>
<mxCell id="wlp" value="Workload

consumes natively" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="239" y="224" width="175" height="62" as="geometry"/></mxCell>
<mxCell id="podid" value="EKS Pod Identity

role trust names one generic
EKS service principal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3E9;strokeColor=#EC7211;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="322" width="175" height="66" as="geometry"/></mxCell>
<mxCell id="role" value="Least-privilege
IAM role

one per workload,
durable across clusters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3E9;strokeColor=#EC7211;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="239" y="322" width="175" height="76" as="geometry"/></mxCell>
<mxCell id="ssm" value="AWS Systems Manager Parameter Store

non-sensitive runtime configuration only; explicitly not the secret store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E5C8A;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="448" width="366" height="62" as="geometry"/></mxCell>
<mxCell id="idc3" value="AWS IAM Identity Center

MFA at sign-in; ReadOnly or Administrator permission set;
short-lived console and CLI credentials;
no long-lived human access keys, bootstrap included" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3E9;strokeColor=#EC7211;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="516" width="366" height="76" as="geometry"/></mxCell>
<mxCell id="tf3" value="Terraform and AWS APIs

owner-executed; automatic apply remains unapproved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#7B42BC;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48" y="606" width="366" height="56" as="geometry"/></mxCell>
<mxCell id="wsig" value="Workload signals

OpenTelemetry instrumentation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EEFA;strokeColor=#6B4FBB;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="468" y="162" width="190" height="58" as="geometry"/></mxCell>
<mxCell id="psig" value="Platform signals

cluster, node, workload state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3F9;strokeColor=#2E5C8A;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="672" y="162" width="182" height="58" as="geometry"/></mxCell>
<mxCell id="otel" value="OpenTelemetry Collector gateway

one per environment and the only entry point for workload telemetry;
enriches with environment, service and artifact digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EEFA;strokeColor=#6B4FBB;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="468" y="246" width="386" height="74" as="geometry"/></mxCell>
<mxCell id="prom" value="Metrics

Prometheus
(decided)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="468" y="344" width="122" height="74" as="geometry"/></mxCell>
<mxCell id="loki" value="Logs

Loki;
Loki is the candidate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="344" width="122" height="74" as="geometry"/></mxCell>
<mxCell id="trace" value="Traces

Jaeger or Tempo;
Tempo provisional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="732" y="344" width="122" height="74" as="geometry"/></mxCell>
<mxCell id="graf" value="Grafana

environment health, workload golden signals, deployed-version view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EEFA;strokeColor=#6B4FBB;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="468" y="444" width="386" height="58" as="geometry"/></mxCell>
<mxCell id="vres" value="Validation results

digests, read-backs, reconciliation records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E5C8A;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="908" y="148" width="344" height="58" as="geometry"/></mxCell>
<mxCell id="rawe" value="Raw evidence

unsanitized, captured before teardown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E5C8A;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="908" y="232" width="344" height="58" as="geometry"/></mxCell>
<mxCell id="s3e" value="Amazon S3 evidence destination

versioned; object versions are its only recovery path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3E9;strokeColor=#EC7211;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="908" y="316" width="344" height="64" as="geometry"/></mxCell>
<mxCell id="sane" value="Sanitized evidence

redacted under the public-artifact rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E5C8A;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="908" y="406" width="344" height="58" as="geometry"/></mxCell>
<mxCell id="ptgt" value="cloud-platform-reference

published on GitHub;
documentation and validation summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEF1;strokeColor=#B0475A;strokeWidth=1.5;fontSize=12;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="908" y="490" width="344" height="82" as="geometry"/></mxCell>
<mxCell id="lc0" value="1. Approve window

purpose, cost, teardown recorded first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6F42;strokeWidth=1.5;fontSize=11.5;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1308" y="142" width="178" height="72" as="geometry"/></mxCell>
<mxCell id="lc1" value="2. Terraform create

from authoritative sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6F42;strokeWidth=1.5;fontSize=11.5;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1498" y="142" width="178" height="72" as="geometry"/></mxCell>
<mxCell id="lc2" value="3. GitOps reconcile

Argo CD applies desired state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6F42;strokeWidth=1.5;fontSize=11.5;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1308" y="226" width="178" height="72" as="geometry"/></mxCell>
<mxCell id="lc3" value="4. Validate

tests and checks that exist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6F42;strokeWidth=1.5;fontSize=11.5;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1498" y="226" width="178" height="72" as="geometry"/></mxCell>
<mxCell id="lc4" value="5. Capture evidence

raw and sanitized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6F42;strokeWidth=1.5;fontSize=11.5;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1308" y="310" width="178" height="72" as="geometry"/></mxCell>
<mxCell id="lc5" value="6. Destroy (reverse order)

ephemeral resources only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6F42;strokeWidth=1.5;fontSize=11.5;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1498" y="310" width="178" height="72" as="geometry"/></mxCell>
<mxCell id="lc6" value="7. Orphan census

verified clean after every teardown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6F42;strokeWidth=1.5;fontSize=11.5;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1308" y="394" width="178" height="72" as="geometry"/></mxCell>
<mxCell id="lc7" value="8. Rebuild next window

foundation is reused, not rebuilt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6F42;strokeWidth=1.5;fontSize=11.5;fontColor=#1B2733;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1498" y="394" width="178" height="72" as="geometry"/></mxCell>
<mxCell id="p2_t0" value="Pod Identity was selected because its role trust names one generic EKS service principal, so IAM roles stay durable and an ephemeral cluster only recreates lightweight associations." style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5A6672;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="48" y="392" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t1" value="Measured clusterlessly, then validated on EKS inside closed runtime windows. No runtime is live now. Clusterless measurement alone is not EKS runtime proof." style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#8A5A00;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="468" y="108" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t2" value="The trace backend is deliberately unselected: ADR-0010 defers the Jaeger-versus-Tempo choice to implementation evidence, and current state keeps Tempo as a provisional candidate only." style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5A6672;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="468" y="518" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t3" value="One validated investigation exercise, a deliberately induced fault traced from alert to root cause to verified recovery, is required before this model counts as implemented. It has now run." style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5A6672;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="468" y="572" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t4" value="AWS-native audit and control-plane records stay in their AWS services. Neither side ingests the other, and no signal is stored twice." style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5A6672;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="468" y="638" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t5" value="Evidence is exported before teardown, and only sanitized evidence is ever published. The repository is published, and its validation summary is the sanitized evidence surface." style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5A6672;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="908" y="582" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t6" value="Exercised end to end across every closed runtime window. Ephemeral runtime resources are removed after every approved window; persistent foundation resources are intentionally retained, so the platform never claims to leave nothing behind." style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5A6672;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1308" y="486" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t7" value="Approved runtime window discipline" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1322" y="578" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t8" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="578" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t9" value="Mandatory teardown after each window" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1322" y="595" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t10" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="595" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t11" value="Budget alerts, notify only" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1322" y="612" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t12" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="612" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t13" value="Six mandatory tag keys" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1322" y="629" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t14" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="629" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t15" value="Orphan-resource verification" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1322" y="646" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t16" value="VALIDATED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#1D6F42;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="646" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t17" value="Automated destructive cost response" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1322" y="663" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t18" value="DEFERRED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#5B4780;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="663" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p2_t19" value="Data / artifact flow" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6672;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48" y="764" width="320" height="40" as="geometry"/></mxCell>
