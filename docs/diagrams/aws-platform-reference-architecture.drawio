<mxCell id="p2_sub" value="Four platform concerns and what each has actually proven." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6672;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="36" y="58" width="1640" height="20" as="geometry"/></mxCell>
