<mxCell id="p1_t3" value="RETAINED" style="text;html=1;align=left;verticalAlign=top;fontSize=9.5;fontColor=#2C6049;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="234" width="320" height="40" as="geometry"/></mxCell>
