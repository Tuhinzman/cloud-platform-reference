<mxCell id="p1_t8" value="Request path:  Client -&gt; public DNS -&gt; load-balancing boundary -&gt; ingress and service boundary -&gt; AstroShop services in private subnets." style="text;html=1;align=left;verticalAlign=top;fontSize=11.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="786" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p1_t9" value="Egress path:  private subnet pods -&gt; single NAT Gateway -&gt; Internet Gateway -&gt; approved external destinations.  Object storage reaches S3 through the gateway endpoint instead." style="text;html=1;align=left;verticalAlign=top;fontSize=11.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="832" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="p1_t10" value="Worker nodes never sit in a public subnet, and map_public_ip_on_launch is false on every subnet, public ones included." style="text;html=1;align=left;verticalAlign=top;fontSize=11.5;fontColor=#1B2733;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="878" width="320" height="40" as="geometry"/></mxCell>
