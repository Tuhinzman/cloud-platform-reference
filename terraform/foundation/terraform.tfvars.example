# Copy to terraform.tfvars and set values you own. The filled copy stays
# untracked. S3 bucket names are globally unique, so the name below is a
# placeholder and will not be available.
#
# This is the evidence bucket, not the Terraform state bucket. The two names
# must differ.
evidence_bucket_name = "example-platform-evidence-000000"

# The dedicated project account. The provider refuses to act on any other
# account. The value below is a placeholder, not an account.
allowed_account_id = "000000000000"

# The GitLab project whose main-branch pipelines may assume the ECR push role,
# given as the immutable numeric project ID the OIDC sub claim carries. Read it
# from the project's Settings, General page. The value below is a placeholder.
gitlab_project_id = 12345678

# The registered apex domain whose public hosted zone this root creates. The
# value below is reserved for documentation (RFC 2606), not a domain you own.
public_domain = "example.com"
