# Copy to terraform.tfvars and set the value you own. The filled copy stays
# untracked.
#
# The dedicated project account. The provider refuses to act on any other
# account. The value below is a placeholder, not an account.
allowed_account_id = "000000000000"

# The one public IPv4 CIDR allowed to reach the EKS public API endpoint. Use
# your own address as a /32. It changes whenever you work from a different
# network, so expect to update the filled copy and re-apply. The value below is
# from the RFC 5737 documentation range and reaches nothing.
operator_cidr = "203.0.113.10/32"

# Alerting campaign. Off by default; the topic, role, policy and association are
# created only when enabled, and the subscription only when it is also enabled.
# The endpoint is a private input and never enters the repository.
# alerting_campaign_enabled           = true
# alerting_email_subscription_enabled = true
# alerting_email_endpoint             = "<the address that receives alerts>"
